{
  "components": {
    "schemas": {
      "AnswerQuestionRequest": {
        "additionalProperties": false,
        "properties": {
          "conversation": {
            "default": [],
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "title": "Conversation",
            "type": "array"
          },
          "question": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "AnswerQuestionRequest",
        "type": "object"
      },
      "CompleteUploadRequest": {
        "additionalProperties": false,
        "properties": {
          "parts": {
            "items": {
              "$ref": "#/components/schemas/MultipartPartRequest"
            },
            "minItems": 1,
            "title": "Parts",
            "type": "array"
          }
        },
        "required": [
          "parts"
        ],
        "title": "CompleteUploadRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "missing_settings": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Missing Settings",
            "type": "array"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "MultipartPartRequest": {
        "additionalProperties": false,
        "properties": {
          "etag": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Etag",
            "type": "string"
          },
          "part_number": {
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Part Number",
            "type": "integer"
          }
        },
        "required": [
          "part_number",
          "etag"
        ],
        "title": "MultipartPartRequest",
        "type": "object"
      },
      "SignedReadResponse": {
        "additionalProperties": false,
        "properties": {
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "SignedReadResponse",
        "type": "object"
      },
      "UploadIntent": {
        "additionalProperties": false,
        "properties": {
          "content_type": {
            "default": "application/pdf",
            "title": "Content Type",
            "type": "string"
          },
          "declared_size_bytes": {
            "exclusiveMinimum": 0.0,
            "maximum": 262144000.0,
            "title": "Declared Size Bytes",
            "type": "integer"
          },
          "display_name": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "original_filename": {
            "maxLength": 255,
            "minLength": 5,
            "title": "Original Filename",
            "type": "string"
          }
        },
        "required": [
          "display_name",
          "original_filename",
          "declared_size_bytes"
        ],
        "title": "UploadIntent",
        "type": "object"
      },
      "UploadPlanResponse": {
        "additionalProperties": false,
        "properties": {
          "document_id": {
            "format": "uuid",
            "title": "Document Id",
            "type": "string"
          },
          "document_version_id": {
            "format": "uuid",
            "title": "Document Version Id",
            "type": "string"
          },
          "part_count": {
            "title": "Part Count",
            "type": "integer"
          },
          "part_size_bytes": {
            "title": "Part Size Bytes",
            "type": "integer"
          },
          "part_upload_urls": {
            "items": {
              "type": "string"
            },
            "title": "Part Upload Urls",
            "type": "array"
          },
          "reservation_id": {
            "format": "uuid",
            "title": "Reservation Id",
            "type": "string"
          }
        },
        "required": [
          "reservation_id",
          "document_id",
          "document_version_id",
          "part_size_bytes",
          "part_count",
          "part_upload_urls"
        ],
        "title": "UploadPlanResponse",
        "type": "object"
      },
      "UploadResponse": {
        "additionalProperties": false,
        "properties": {
          "document_id": {
            "format": "uuid",
            "title": "Document Id",
            "type": "string"
          },
          "document_version_id": {
            "format": "uuid",
            "title": "Document Version Id",
            "type": "string"
          },
          "reservation_id": {
            "format": "uuid",
            "title": "Reservation Id",
            "type": "string"
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sha256"
          },
          "state": {
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "reservation_id",
          "document_id",
          "document_version_id",
          "state"
        ],
        "title": "UploadResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Evidence-backed technical PDF investigation API.",
    "title": "Document Intelligence API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "liveness_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness",
        "tags": [
          "system"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness",
        "tags": [
          "system"
        ]
      }
    },
    "/v1/answers:stream": {
      "post": {
        "operationId": "stream_answer_v1_answers_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnswerQuestionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Server-sent answer events"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Stream Answer",
        "tags": [
          "answers"
        ]
      }
    },
    "/v1/uploads": {
      "post": {
        "operationId": "reserve_v1_uploads_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadIntent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadPlanResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Reserve",
        "tags": [
          "uploads"
        ]
      }
    },
    "/v1/uploads/{reservation_id}": {
      "delete": {
        "operationId": "abort_v1_uploads__reservation_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "reservation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Reservation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Abort",
        "tags": [
          "uploads"
        ]
      }
    },
    "/v1/uploads/{reservation_id}/complete": {
      "post": {
        "operationId": "complete_v1_uploads__reservation_id__complete_post",
        "parameters": [
          {
            "in": "path",
            "name": "reservation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Reservation Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteUploadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Complete",
        "tags": [
          "uploads"
        ]
      }
    },
    "/v1/uploads/{reservation_id}/read": {
      "get": {
        "operationId": "signed_read_v1_uploads__reservation_id__read_get",
        "parameters": [
          {
            "in": "path",
            "name": "reservation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Reservation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedReadResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Signed Read",
        "tags": [
          "uploads"
        ]
      }
    }
  }
}
